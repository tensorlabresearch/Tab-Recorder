{
  "private": true,
  "type": "module",
  "name": "tab-recorder",
  "version": "1.15.0",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PWHEADLESS=false xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "vendor:transformers": "bash scripts/vendor-transformers.sh"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^9.30.0",
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "vitest": "^3.2.7"
  }
}
